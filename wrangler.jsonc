{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mojemeteo",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "UPLOAD_TOKEN": "xK9m2vP7qR3wL8nT4bZ6yF1jH5c"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mojemeteo-db",
      "database_id": "2946e7d3-5457-479c-b34c-bf44ab9c3668"
    }
  ],
  "routes": [
    {
      "pattern": "mojemeteo.com",
      "custom_domain": true
    },
    {
      "pattern": "www.mojemeteo.com",
      "custom_domain": true
    }
  ]
}

